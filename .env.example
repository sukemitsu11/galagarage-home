# Скопируйте в .env и задайте свои значения.
# ADMIN_PASSWORD: не короче 12 символов. SESSION_SECRET: любая случайная строка от 32 символов.
ADMIN_PASSWORD=
DB_PASSWORD=
SESSION_SECRET=

# Ваш логин на Docker Hub (нужен для сборки и пуша образов) и тег версии
DOCKERHUB_USER=
TAG=latest

# Порт сайта. BIND_ADDR=0.0.0.0, если сайт должен быть доступен снаружи сервера
HTTP_PORT=8080
BIND_ADDR=127.0.0.1

# true, когда сайт открыт по https (включает Secure для cookie и HSTS)
SECURE_COOKIES=false
SEED_DEMO=true
